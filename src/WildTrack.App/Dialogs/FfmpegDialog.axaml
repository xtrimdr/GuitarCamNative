<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WildTrack.App"
             x:Class="WildTrack.App.Dialogs.FfmpegDialog"
             AutomationProperties.Name="{loc:T ffmpeg.title}"
             Background="#B3000000" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">

  <!-- same frame as UnsavedDialog: shown at startup when FFmpeg is missing, and from the top bar's "FFmpeg no encontrado" -->
  <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <StackPanel Margin="24,22,24,20" Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="icon" Text="&#xE896;" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        <TextBlock Text="{loc:T ffmpeg.title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="dim" TextWrapping="Wrap" LineHeight="18" Text="{loc:T ffmpeg.body}" />
      <TextBlock x:Name="HowText" Classes="dim" TextWrapping="Wrap" LineHeight="18" />
      <Border Background="{StaticResource Raised}" CornerRadius="6" Padding="10,6">
        <Grid ColumnDefinitions="*,Auto">
          <SelectableTextBlock x:Name="CommandText" Classes="mono" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="CopyButton" Classes="ghost" Padding="6,2" ToolTip.Tip="{loc:T ffmpeg.copy.tip}">
            <TextBlock Classes="icon" Text="&#xE8C8;" FontSize="13" />
          </Button>
        </Grid>
      </Border>
      <TextBlock x:Name="StateText" TextWrapping="Wrap" LineHeight="18" IsVisible="False" />
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Button x:Name="PageButton" Classes="btn" Content="{loc:T ffmpeg.page}" ToolTip.Tip="{loc:T ffmpeg.page.tip}" />
        <Button Grid.Column="1" x:Name="RecheckButton" Classes="btn" Margin="8,0,0,0" Content="{loc:T ffmpeg.recheck}" ToolTip.Tip="{loc:T ffmpeg.recheck.tip}" />
        <Button Grid.Column="3" x:Name="LaterButton" Classes="btn" Margin="8,0,0,0" Content="{loc:T ffmpeg.later}" />
        <Button Grid.Column="4" x:Name="InstallButton" Classes="btn primary" Margin="8,0,0,0" Padding="16,0" Content="{loc:T ffmpeg.install}" ToolTip.Tip="{loc:T ffmpeg.install.tip}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
