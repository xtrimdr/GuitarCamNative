<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:WildTrack.App"
        x:Class="WildTrack.App.SplashWindow"
        Title="WildTrack"
        Icon="/Assets/WildTrack.ico"
        Width="600" Height="360" CanResize="False" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" SystemDecorations="None" Topmost="True"
        TransparencyLevelHint="Transparent" Background="Transparent">

  <Border x:Name="Card" CornerRadius="10" Background="{StaticResource App}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True" Opacity="0">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
      </Transitions>
    </Border.Transitions>
    <Grid RowDefinitions="*,Auto">
      <!-- the accent glow behind the icon -->
      <Ellipse x:Name="Glow" Grid.RowSpan="2" Width="520" Height="520" Margin="-220,-170,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />

      <StackPanel Orientation="Horizontal" Spacing="30" Margin="36,0,36,4" VerticalAlignment="Center">
        <Image x:Name="Logo" Width="220" Height="220" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <StackPanel VerticalAlignment="Center" Spacing="6">
          <TextBlock Text="WildTrack" FontSize="40" FontWeight="SemiBold" LetterSpacing="-0.6" Foreground="{StaticResource Fg}" />
          <TextBlock Text="{loc:T splash.tagline}" FontSize="13" Foreground="{StaticResource Faint}" Margin="2,2,0,0" />
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,0,24,18">
        <TextBlock Text="{loc:T splash.loading}" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border x:Name="TestChip" IsVisible="False" Background="{StaticResource RecSoft}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
            <TextBlock x:Name="TestText" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Rec}" />
          </Border>
          <TextBlock x:Name="VersionText" Classes="mono" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- indeterminate bar: a short accent stripe sliding along the bottom edge -->
      <Canvas Grid.Row="1" x:Name="Track" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Raised}" ClipToBounds="True">
        <Border x:Name="Stripe" Width="140" Height="2" />
      </Canvas>
    </Grid>
  </Border>
</Window>
