<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GuitarCam.App.App"
             RequestedThemeVariant="Dark">

  <!-- Same tokens as the web app (index.css @theme): app/panel/raised/hover/line, fg/dim/faint, accent, rec. -->
  <Application.Resources>
    <Color x:Key="AppColor">#0b0b0d</Color>
    <Color x:Key="PanelColor">#131316</Color>
    <Color x:Key="RaisedColor">#1c1c20</Color>
    <Color x:Key="HoverColor">#26262b</Color>
    <Color x:Key="LineColor">#27272c</Color>
    <Color x:Key="FgColor">#ececef</Color>
    <Color x:Key="DimColor">#a1a1aa</Color>
    <Color x:Key="FaintColor">#6b6b74</Color>
    <Color x:Key="AccentColor">#22d3ee</Color>
    <Color x:Key="RecColor">#ef4444</Color>

    <SolidColorBrush x:Key="App" Color="{StaticResource AppColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2422d3ee" />
    <!-- accent variants, recolored with the theme (Theme.cs): text on accent, hover, and the alpha steps the styles use -->
    <SolidColorBrush x:Key="AccentFg" Color="#0b0b0d" />
    <SolidColorBrush x:Key="AccentHover" Color="#4fdcf1" />
    <SolidColorBrush x:Key="AccentTint" Color="#0F22d3ee" />
    <SolidColorBrush x:Key="Accent25" Color="#4022d3ee" />
    <SolidColorBrush x:Key="Accent40" Color="#6622d3ee" />
    <SolidColorBrush x:Key="Accent50" Color="#8022d3ee" />
    <SolidColorBrush x:Key="Accent70" Color="#B322d3ee" />
    <SolidColorBrush x:Key="Rec" Color="{StaticResource RecColor}" />
    <SolidColorBrush x:Key="RecSoft" Color="#24ef4444" />
    <!-- the tuner's "in tune": the mixer meters' green (Palette.MeterGreen / Palette.InTune) -->
    <SolidColorBrush x:Key="InTune" Color="#22c55e" />

    <!-- Fluent controls (sliders, switches) take the accent from these -->
    <Color x:Key="SystemAccentColor">#22d3ee</Color>
    <Color x:Key="SystemAccentColorDark1">#1fbfd7</Color>
    <Color x:Key="SystemAccentColorDark2">#1aa6bb</Color>
    <Color x:Key="SystemAccentColorDark3">#158a9c</Color>
    <Color x:Key="SystemAccentColorLight1">#4fdcf1</Color>
    <Color x:Key="SystemAccentColorLight2">#7ce5f4</Color>
    <Color x:Key="SystemAccentColorLight3">#a9eef8</Color>

    <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Segoe has no metronome: body with a window, pendulum and weight on a 16 px grid (nonzero fill) -->
    <StreamGeometry x:Key="MetronomeIcon">F1 M5,1 L11,1 L15,15 L1,15 Z M5.9,2.5 L3.6,10.5 L12.4,10.5 L10.1,2.5 Z M3.2,12 L2.7,13.7 L13.3,13.7 L12.8,12 Z M10.6,2.94 L11.8,3.46 L8.6,10.76 L7.4,10.24 Z M11.55,6.4 L10.91,7.86 L7.97,6.58 L8.61,5.12 Z</StreamGeometry>
    <!-- Segoe has no magnet: two pole caps over a U, on a 16 px grid (the web's Magnet icon in the snap box) -->
    <StreamGeometry x:Key="MagnetIcon">F1 M2,1 L5.6,1 L5.6,3.8 L2,3.8 Z M10.4,1 L14,1 L14,3.8 L10.4,3.8 Z M2,5 L5.6,5 L5.6,9 A2.4,2.4 0 0 0 10.4,9 L10.4,5 L14,5 L14,9 A6,6 0 0 1 2,9 Z</StreamGeometry>
    <!-- lucide ChevronsDownUp / ChevronsUpDown (the inspector's fold-all button), filled on a 24 px grid -->
    <StreamGeometry x:Key="CollapseAllIcon">M7,4 L12,9 L17,4 L17,6.2 L12,11.2 L7,6.2 Z M7,20 L12,15 L17,20 L17,17.8 L12,12.8 L7,17.8 Z</StreamGeometry>
    <StreamGeometry x:Key="ExpandAllIcon">M7,9 L12,4 L17,9 L17,11.2 L12,6.2 L7,11.2 Z M7,15 L12,20 L17,15 L17,12.8 L12,17.8 L7,12.8 Z</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <Style Selector="MenuItem.danger:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource RecSoft}" />
    </Style>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource Ui}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="{StaticResource App}" />
    </Style>

    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    </Style>

    <!-- chip buttons: outlined like the web's IconButton / ChipToggle (transparent, border-line, text-dim) -->
    <Style Selector=":is(Button).chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector=":is(Button).chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>
    <!-- off toggles are faint and only brighten their text on hover (ChipToggle in TransportBar.tsx) -->
    <Style Selector="ToggleButton.chip">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="ToggleButton.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- recording buttons (TransportBar.tsx): hover keeps their own color -->
    <Style Selector="Button.chip.rec-stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f25a5a" />
      <Setter Property="BorderBrush" Value="#f25a5a" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chip.discard">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="Button.chip.discard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource RecSoft}" />
      <Setter Property="BorderBrush" Value="#66ef4444" />
      <Setter Property="Foreground" Value="{StaticResource Rec}" />
    </Style>
    <Style Selector="Button.chip.count:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent25}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent50}" />
    </Style>
    <!-- on: accent-soft fill, accent/40 border, accent text; also Button.chip.on (play while playing) -->
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.chip.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent40}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent25}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent40}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.chip.inspector-power:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip.inspector-power:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
    </Style>
    <Style Selector="ToggleButton.chip.inspector-power:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <!-- disabled: the web fades the whole button (disabled:opacity-35) -->
    <Style Selector=":is(Button).chip:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector=":is(Button).chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>
    <Style Selector="ToggleButton.chip:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent40}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.chip.inspector-power:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- bottom transport bar (Fender Studio Pro style): flat icon buttons, value-over-label cells -->
    <Style Selector=":is(Button).tbtn">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).tbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(Button).tbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="ToggleButton.tbtn">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style Selector="ToggleButton.tbtn:checked /template/ ContentPresenter#PART_ContentPresenter, Button.tbtn.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.tbtn:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tbtn.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector=":is(Button).tbtn:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector=":is(Button).tbtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.clock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="38" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.clock:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.clock:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <!-- divider between the groups of the transport box: inset so it doesn't touch the border -->
    <Style Selector="Border.vsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="0,8" />
      <Setter Property="Background" Value="{StaticResource Line}" />
    </Style>
    <Style Selector="StackPanel.bar-cell">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.bar-cell > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- metronome panel: one box with flush cells split by 1 px lines (Studio One style) -->
    <Style Selector="Border.metro">
      <Setter Property="Background" Value="{StaticResource App}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="40" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.metro-cell">
      <Setter Property="Margin" Value="14,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.metro-value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.metro-label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.cell PathIcon">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="ToggleButton.cell:checked PathIcon">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.cell TextBlock.icon">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="ToggleButton.cell:checked TextBlock.icon">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector=":is(Button).cell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="38" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).cell:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(Button).cell:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="ToggleButton.cell:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.cell:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.cell:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- segmented control (Segmented in ui.tsx): a raised box with the active option as a lighter pill -->
    <Style Selector="Border.seg">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).seg:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(Button).seg:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.seg:checked:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.seg.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1cffffff" />
      <Setter Property="BorderBrush" Value="#0fffffff" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector=":is(Button).seg:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <!-- accent variant: compressor style picker (CompControl.tsx) -->
    <Style Selector="ToggleButton.seg.pick">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ToggleButton.seg.pick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="ToggleButton.seg.pick:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.seg.pick:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent50}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>

    <!-- an open popover's button (IconButton active in ui.tsx; the web's border is transparent in the top bar) -->
    <Style Selector="Button.ghost.on /template/ ContentPresenter#PART_ContentPresenter, Button.ghost.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <!-- theme swatches: the swatch itself is the button, no hover fill -->
    <Style Selector="Button.swatch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
    </Style>

    <!-- "Borrar no usadas" (HistoryPanel.tsx): a faint outline that turns red on hover -->
    <Style Selector="Button.chip.purge">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style Selector="Button.chip.purge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource RecSoft}" />
      <Setter Property="BorderBrush" Value="#66ef4444" />
      <Setter Property="Foreground" Value="{StaticResource Rec}" />
    </Style>

    <!-- text fields and dialog buttons (SessionPicker, Historial): field, accent / outline / ghost / danger, row action -->
    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent70}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- the take name in the inspector: reads as a title, shows a Raised box on hover and while editing (TakeInspector.tsx input) -->
    <Style Selector="TextBox.title">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.title:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.title:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent40}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>

    <!-- buttons: accent (h-9 / h-8), outline, ghost, row action, danger -->
    <Style Selector="Button.btn">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.btn.sm">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.btn.outline">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.btn.outline /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="Button.btn.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.btn.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>
    <Style Selector="Button.btn.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.btn.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
    </Style>
    <Style Selector="Button.btn.danger">
      <Setter Property="Background" Value="{StaticResource Rec}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.btn.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f26464" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.btn.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
    </Style>
    <Style Selector="Button.btn.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Rec}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.act">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.act:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.act.danger">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style Selector="Button.act.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource RecSoft}" />
      <Setter Property="Foreground" Value="{StaticResource Rec}" />
    </Style>
    <Style Selector="Button.act:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!-- Loader2: an open ring that turns -->
    <Style Selector="Arc.spin">
      <Setter Property="StartAngle" Value="0" />
      <Setter Property="SweepAngle" Value="270" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,-6" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
  </Application.Styles>
</Application>
