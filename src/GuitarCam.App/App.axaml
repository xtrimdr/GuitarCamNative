<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GuitarCam.App.App"
             RequestedThemeVariant="Dark">

  <!-- Same tokens as the web app (index.css @theme): app/panel/raised/hover/line, fg/dim/faint, accent, rec. -->
  <Application.Resources>
    <Color x:Key="AppColor">#0b0b0d</Color>
    <Color x:Key="PanelColor">#131316</Color>
    <Color x:Key="RaisedColor">#1c1c20</Color>
    <Color x:Key="HoverColor">#26262b</Color>
    <Color x:Key="LineColor">#27272c</Color>
    <Color x:Key="FgColor">#ececef</Color>
    <Color x:Key="DimColor">#a1a1aa</Color>
    <Color x:Key="FaintColor">#6b6b74</Color>
    <Color x:Key="AccentColor">#22d3ee</Color>
    <Color x:Key="RecColor">#ef4444</Color>

    <SolidColorBrush x:Key="App" Color="{StaticResource AppColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2422d3ee" />
    <SolidColorBrush x:Key="Rec" Color="{StaticResource RecColor}" />
    <SolidColorBrush x:Key="RecSoft" Color="#24ef4444" />

    <!-- Fluent controls (sliders, switches) take the accent from these -->
    <Color x:Key="SystemAccentColor">#22d3ee</Color>
    <Color x:Key="SystemAccentColorDark1">#1fbfd7</Color>
    <Color x:Key="SystemAccentColorDark2">#1aa6bb</Color>
    <Color x:Key="SystemAccentColorDark3">#158a9c</Color>
    <Color x:Key="SystemAccentColorLight1">#4fdcf1</Color>
    <Color x:Key="SystemAccentColorLight2">#7ce5f4</Color>
    <Color x:Key="SystemAccentColorLight3">#a9eef8</Color>

    <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <Style Selector="MenuItem.danger:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource RecSoft}" />
    </Style>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource Ui}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="{StaticResource App}" />
    </Style>

    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    </Style>

    <!-- chip buttons -->
    <Style Selector=":is(Button).chip">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <!-- recording buttons (TransportBar.tsx): hover keeps their own color -->
    <Style Selector="Button.chip.rec:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#40ef4444" />
      <Setter Property="BorderBrush" Value="#80ef4444" />
    </Style>
    <Style Selector="Button.chip.rec-stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#f25a5a" />
      <Setter Property="BorderBrush" Value="#f25a5a" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chip.discard">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="Button.chip.discard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource RecSoft}" />
      <Setter Property="BorderBrush" Value="#66ef4444" />
      <Setter Property="Foreground" Value="{StaticResource Rec}" />
    </Style>
    <Style Selector="Button.chip.count:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4022d3ee" />
      <Setter Property="BorderBrush" Value="#8022d3ee" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.chip.inspector-power:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource App}" />
    </Style>
    <Style Selector="Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#0b0b0d" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4fdcf1" />
      <Setter Property="Foreground" Value="#0b0b0d" />
    </Style>

    <!-- round transport buttons -->
    <Style Selector=":is(Button).transport">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.transport.play">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#0b0b0d" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.transport.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4fdcf1" />
      <Setter Property="Foreground" Value="#0b0b0d" />
    </Style>
    <Style Selector="Button.transport.rec">
      <Setter Property="Foreground" Value="{StaticResource Rec}" />
    </Style>

    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,-6" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
  </Application.Styles>
</Application>
