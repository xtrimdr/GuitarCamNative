<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GuitarCam.App"
             x:Class="GuitarCam.App.Dialogs.ExportDialog"
             AutomationProperties.Name="{loc:T export.name}"
             Background="#B3000000" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">

  <!-- Port of ExportSetupDialog, ExportProgressDialog, ExportErrorDialog and ExportDialog
       from GuitarCam/src/components/ExportDialog.tsx -->
  <UserControl.Styles>
    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent70}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>

    <Style Selector="Button.btn">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.btn.outline">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.btn.outline /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="Button.btn.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.btn.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- on the presenter in every state, like Button.accent in App.axaml -->
    <Style Selector="Button.btn.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
    </Style>
    <Style Selector="Button.btn.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Rec}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.btn.danger">
      <Setter Property="Background" Value="{StaticResource Rec}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.btn.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentFg}" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>
    <Style Selector="Button.link.accent">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.link.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
    </Style>

    <Style Selector="Button.act">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.act:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
    </Style>

  </UserControl.Styles>

  <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Width="512" Margin="16"
          AutomationProperties.Name="{loc:T export.name}"
          Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 25 50 -12 #80000000" ClipToBounds="True">
    <StackPanel>

      <!-- Header -->
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="HeaderTitle" Text="{loc:T export.mp4}" FontSize="14" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="HeaderSubtitle" Classes="mono" FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
              <Button x:Name="CopyPathButton" Classes="link" ToolTip.Tip="{loc:T exp.copyPath}" IsVisible="False" VerticalAlignment="Center">
                <TextBlock x:Name="CopyPathIcon" Classes="icon" Text="&#xE8C8;" FontSize="12" />
              </Button>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" x:Name="CloseButton" Classes="act" Margin="8,-2,-6,0" VerticalAlignment="Top"
                  ToolTip.Tip="{loc:T settings.close}" AutomationProperties.Name="Cerrar">
            <TextBlock Classes="icon" Text="&#xE711;" FontSize="13" />
          </Button>
        </Grid>
      </Border>

      <!-- Phase 1: Setup -->
      <StackPanel x:Name="SetupPanel" Spacing="0">
        <StackPanel Margin="20,16" Spacing="16">

          <!-- Nombre del archivo -->
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:T exp.fileName}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Dim}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="FileNameBox" Classes="field" Watermark="{loc:T exp.myVideo}" MaxLength="180" />
              <TextBlock Grid.Column="1" x:Name="ExtText" Classes="mono" Text=".mp4" FontSize="14" Foreground="{StaticResource Faint}"
                         VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>

          <!-- Carpeta -->
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:T exp.folder}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Dim}" />
            <Grid ColumnDefinitions="*,Auto">
              <Border Height="36" Padding="12,0" CornerRadius="6" Background="{StaticResource Raised}"
                      BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Classes="icon" Text="&#xE8DA;" FontSize="14" Foreground="{StaticResource Faint}" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" x:Name="FolderText" Classes="mono" FontSize="12" Foreground="{StaticResource Fg}"
                             VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis" />
                </Grid>
              </Border>
              <Button Grid.Column="1" x:Name="PickFolderButton" Classes="btn outline" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Arc x:Name="PickFolderSpin" Classes="spin" Width="14" Height="14" Stroke="{StaticResource Dim}" IsVisible="False" />
                  <TextBlock Text="{loc:T proj.change}" />
                </StackPanel>
              </Button>
            </Grid>
            <Panel MinHeight="16">
              <TextBlock x:Name="DefaultFolderHint" Text="{loc:T exp.folder.default}" FontSize="11" Foreground="{StaticResource Faint}" />
              <Button x:Name="ResetFolderButton" Classes="link" ToolTip.Tip="{loc:T exp.folder.reset.tip}" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="icon" Text="&#xE777;" FontSize="11" />
                  <TextBlock Text="{loc:T exp.folder.reset}" />
                </StackPanel>
              </Button>
            </Panel>
          </StackPanel>

          <!-- Destino (native only): a social preset swaps the frame and masters the mix to its loudness;
               "Proyecto" is the default and leaves both as they are -->
          <StackPanel x:Name="TargetPanel" Spacing="6">
            <TextBlock Text="{loc:T exp.target}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Dim}" />
            <Border Classes="seg" HorizontalAlignment="Left">
              <StackPanel x:Name="TargetButtons" Orientation="Horizontal" Spacing="2" />
            </Border>
            <TextBlock x:Name="TargetDescText" Classes="mono" FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Calidad -->
          <StackPanel Spacing="6">
            <TextBlock x:Name="QualityLabel" Text="{loc:T exp.quality}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Dim}" />
            <Grid ColumnDefinitions="Auto,Auto,*">
              <!-- solo audio (native only): the format instead of the video quality -->
              <Border x:Name="FormatSeg" Classes="seg" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button x:Name="FormatWavBtn" Classes="seg on" Content="WAV" ToolTip.Tip="{loc:T exp.wav.tip}" />
                  <Button x:Name="FormatMp3Btn" Classes="seg" Content="MP3" ToolTip.Tip="{loc:T exp.mp3.tip}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" x:Name="QualitySeg" Classes="seg">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button x:Name="QualityAltaBtn" Classes="seg on" Content="{loc:T exp.q.high}"
                          ToolTip.Tip="{loc:T exp.q.high.tip}" />
                  <Button x:Name="QualityEstandarBtn" Classes="seg" Content="{loc:T exp.q.std}"
                          ToolTip.Tip="{loc:T exp.q.std.tip}" />
                  <Button x:Name="QualityBorradorBtn" Classes="seg" Content="{loc:T exp.q.draft}"
                          ToolTip.Tip="{loc:T exp.q.draft.tip}" />
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="2" x:Name="EstBytesText" Classes="mono" FontSize="11" Foreground="{StaticResource Faint}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="QualityDescText" FontSize="11" Foreground="{StaticResource Faint}" />
            <!-- solo audio (native only): master to the streaming loudness -->
            <CheckBox x:Name="AudioLufsCheck" Content="{loc:T exp.audioLufs}" FontSize="12" ToolTip.Tip="{loc:T exp.audioLufs.tip}" IsVisible="False" />
            <!-- native only: each track to its own WAV next to the export -->
            <CheckBox x:Name="StemsCheck" Content="{loc:T exp.stems}" FontSize="12" ToolTip.Tip="{loc:T exp.stems.tip}" />
          </StackPanel>

          <!-- Warning / Collision banner -->
          <Border x:Name="WarningBanner" CornerRadius="6" BorderThickness="1" Padding="12,10" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock x:Name="WarningIcon" Classes="icon" Text="&#xE7BA;" FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0" />
              <WrapPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="WarningText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="UseSuggestedButton" Classes="link accent" Margin="6,0,0,0" IsVisible="False" VerticalAlignment="Center">
                  <TextBlock x:Name="UseSuggestedText" TextDecorations="Underline" />
                </Button>
              </WrapPanel>
            </Grid>
          </Border>

          <!-- Full destination path -->
          <TextBlock x:Name="FullPathPreview" Classes="mono" FontSize="11" Foreground="{StaticResource Faint}"
                     TextWrapping="Wrap" Margin="0,-4,0,0" />
        </StackPanel>

        <!-- Setup Footer -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="SetupCancelButton" Classes="btn" Content="{loc:T transport.count.cancel}" />
            <Button x:Name="SetupStartButton" Classes="btn primary">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xE896;" FontSize="13" Foreground="{StaticResource AccentFg}" />
                <TextBlock x:Name="SetupStartText" Text="{loc:T exp.start}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Phase 2: Running -->
      <StackPanel x:Name="RunningPanel" IsVisible="False" Spacing="0">
        <StackPanel Margin="20,20" Spacing="20">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="ProgressPctText" Classes="mono" FontSize="30" FontWeight="SemiBold" Text="0%" />
              <TextBlock Grid.Column="1" x:Name="ProgressTimeText" Classes="mono" FontSize="11"
                         Foreground="{StaticResource Faint}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </Grid>
            <Border x:Name="ProgressBarTrack" Height="8" CornerRadius="4" Background="{StaticResource Raised}" ClipToBounds="True">
              <Border x:Name="ProgressBarFill" Height="8" CornerRadius="4" Background="{StaticResource Accent}"
                      HorizontalAlignment="Left" Width="0" />
            </Border>
          </StackPanel>

          <StackPanel x:Name="StepsList" Spacing="10" />
        </StackPanel>

        <!-- Running Footer -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
          <Panel>
            <Button x:Name="RunningCancelButton" Classes="btn" Content="{loc:T transport.count.cancel}" HorizontalAlignment="Right" />
            <Grid x:Name="ConfirmCancelRow" ColumnDefinitions="*,Auto,Auto" IsVisible="False">
              <TextBlock Text="{loc:T exp.cancelAsk}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
              <Button Grid.Column="1" x:Name="KeepRunningButton" Classes="btn" Content="{loc:T exp.keep}" />
              <Button Grid.Column="2" x:Name="AbortExportButton" Classes="btn danger" Content="{loc:T exp.abort}" Margin="8,0,0,0" />
            </Grid>
          </Panel>
        </Border>
      </StackPanel>

      <!-- Phase 3: Error -->
      <StackPanel x:Name="ErrorPanel" IsVisible="False" Spacing="0">
        <StackPanel Margin="20,16" Spacing="12">
          <Border CornerRadius="6" BorderBrush="#66ef4444" BorderThickness="1" Background="{StaticResource RecSoft}" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Classes="icon" Text="&#xE7BA;" FontSize="14" Foreground="{StaticResource Rec}" VerticalAlignment="Top" Margin="0,2,8,0" />
              <TextBlock Grid.Column="1" x:Name="ErrorMessageText" FontSize="14" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <StackPanel x:Name="ErrorDetailsSection" Spacing="8" IsVisible="False">
            <Button x:Name="ToggleDetailsButton" Classes="link">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="DetailsChevron" Classes="icon" Text="&#xE76C;" FontSize="10" />
                <TextBlock Text="{loc:T exp.details}" />
              </StackPanel>
            </Button>
            <Border x:Name="ErrorDetailsBox" Background="{StaticResource App}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="12" MaxHeight="224" IsVisible="False">
              <ScrollViewer>
                <SelectableTextBlock x:Name="ErrorDetailsText" Classes="mono" FontSize="10" Foreground="{StaticResource Dim}" TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Error Footer -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ErrorCloseButton" Classes="btn" Content="{loc:T settings.close}" />
            <Button x:Name="ErrorRetryButton" Classes="btn primary" Content="{loc:T exp.retry}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Phase 4: Done -->
      <StackPanel x:Name="DonePanel" IsVisible="False" Spacing="0">
        <!-- an exported audio file (native only): its name and length instead of the picture -->
        <Grid x:Name="AudioDoneRow" ColumnDefinitions="Auto,*" Margin="20,18" IsVisible="False">
          <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
            <TextBlock Classes="icon" Text="&#xE8D6;" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="AudioDoneName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AudioDoneInfo" Classes="mono" FontSize="11" Foreground="{StaticResource Faint}" />
          </StackPanel>
        </Grid>
        <Border x:Name="DoneStage" Background="Black" MinHeight="220">
          <Panel>
            <TextBlock x:Name="MissingVideoText"
                       Text="{loc:T exp.fileGone}"
                       FontSize="14" Foreground="{StaticResource Dim}" Margin="24,64"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" IsVisible="False" />
            <Grid x:Name="VideoPreviewContainer" RowDefinitions="*,Auto">
              <Image x:Name="DoneVideoImage" MaxHeight="440" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Grid.Row="1" Background="#CC09090b" Padding="12,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button x:Name="DonePlayPauseButton" Classes="act" Width="28" Height="28" ToolTip.Tip="{loc:T exp.preview.tip}">
                    <TextBlock x:Name="DonePlayPauseIcon" Classes="icon" Text="&#xE768;" FontSize="12" />
                  </Button>
                  <Slider Grid.Column="1" x:Name="DoneVideoSlider" Minimum="0" Maximum="1" Value="0" Margin="10,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" x:Name="DoneVideoTimeText" Classes="mono" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
          </Panel>
        </Border>

        <!-- Done Footer -->
        <Border Padding="20,14">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock x:Name="DoneMetaText" Classes="mono" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="DoneCloseButton" Classes="btn" Content="{loc:T settings.close}" />
            <Button Grid.Column="2" x:Name="DoneRevealButton" Classes="btn primary" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xE8DA;" FontSize="14" Foreground="{StaticResource AccentFg}" />
                <TextBlock Text="{loc:T exp.showFolder}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </StackPanel>

    </StackPanel>
  </Border>
</UserControl>
