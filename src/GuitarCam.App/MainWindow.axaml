<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GuitarCam.App.Controls"
        xmlns:d="using:GuitarCam.App.Dialogs"
        x:Class="GuitarCam.App.MainWindow"
        Title="GuitarCam Studio Native"
        Icon="/Assets/GuitarCam.ico"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="None"
        Background="{StaticResource App}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome">

  <!-- TransparencyLevelHint None: with transparency allowed, some dark video pixels let the window behind show through -->
  <Window.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.section.off TextBlock.dim, Border.section.off Slider, Border.section.off UniformGrid, Border.section.off CheckBox">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </Window.Styles>

  <!-- maximized, Windows pushes a window with our own title bar 8 px past each screen edge: OffScreenMargin
       says how much, so the content stays on screen -->
  <Grid x:Name="Root" RowDefinitions="44,*,4,280,Auto" ColumnDefinitions="*,Auto" Margin="{Binding $parent[Window].OffScreenMargin}">

    <!-- top bar (also the window's title bar) -->
    <Border x:Name="TitleBar" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="12,0,150,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="LogoButton" Classes="ghost" Padding="2" Margin="-2,0" ToolTip.Tip="Acerca de GuitarCam Studio Native" AutomationProperties.Name="Acerca de">
            <Image Source="/Assets/GuitarCam-64.png" Width="24" Height="24" RenderOptions.BitmapInterpolationMode="HighQuality" />
          </Button>
          <TextBlock Text="GuitarCam Studio" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
          <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
            <TextBlock Text="NATIVE" FontSize="9.5" FontWeight="Bold" LetterSpacing="0.8" Foreground="{StaticResource Accent}" />
          </Border>
        </StackPanel>

        <Button Grid.Column="1" x:Name="SessionChip" Classes="ghost" Foreground="{StaticResource Fg}" Height="32" Padding="10,0" VerticalContentAlignment="Center" FontSize="12" Margin="18,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" Text="&#xE8B7;" FontSize="13" Foreground="{StaticResource Dim}" />
            <TextBlock x:Name="SessionName" Text="Sin proyecto" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
            <!-- save state (the web's Guardando / Guardado / Error al guardar next to the name) -->
            <StackPanel x:Name="SaveState" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
              <Arc x:Name="SaveSpin" Classes="spin" Width="11" Height="11" StrokeThickness="1.5" Stroke="{StaticResource Dim}" IsVisible="False" />
              <TextBlock x:Name="SaveIcon" Classes="icon" Text="&#xE73E;" FontSize="10" Foreground="{StaticResource Faint}" />
              <TextBlock x:Name="SaveText" Text="Guardado" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Faint}" />
            </StackPanel>
            <TextBlock Classes="icon" Text="&#xE70D;" FontSize="9" Foreground="{StaticResource Faint}" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
          <!-- the project's mode (native only): video, or solo audio without stage, camera or MP4 -->
          <Border Classes="seg" Margin="0,0,10,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="ModeVideoButton" Classes="seg" ToolTip.Tip="Proyecto con video: un panel por pista, cámara y exportar MP4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE714;" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock x:Name="ModeVideoText" Text="Video" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ModeAudioButton" Classes="seg" ToolTip.Tip="Proyecto solo de audio: sin cámara ni video; exportás la mezcla en WAV o MP3. Podés volver a Video cuando quieras: no se borra nada">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE8D6;" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock x:Name="ModeAudioText" Text="Solo audio" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Border>
          <Button x:Name="UndoButton" Classes="ghost" IsEnabled="False" ToolTip.Tip="Deshacer (Ctrl+Z)">
            <TextBlock Classes="icon" Text="&#xE7A7;" />
          </Button>
          <Button x:Name="RedoButton" Classes="ghost" IsEnabled="False" ToolTip.Tip="Rehacer (Ctrl+Y)">
            <TextBlock Classes="icon" Text="&#xE7A6;" />
          </Button>
        </StackPanel>

        <TextBlock Grid.Column="3" x:Name="StatusText" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" Margin="0,0,14,0" VerticalAlignment="Center">
          <!-- system load, camera, sample rate and FFmpeg (the web's text-[11px] text-faint group) -->
          <StackPanel x:Name="SystemInfo" Orientation="Horizontal" Spacing="16" Margin="0,0,6,0" VerticalAlignment="Center">
            <c:SystemMeter x:Name="SysMeter" />
            <Border x:Name="SysMeterSep" Width="1" Height="16" Background="{StaticResource Line}" />
            <TextBlock x:Name="CameraResText" Classes="mono" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center" IsVisible="False" />
            <TextBlock x:Name="SampleRateText" Classes="mono" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Text="48 kHz" />
            <StackPanel x:Name="FfmpegState" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="Buscando FFmpeg…">
              <Ellipse x:Name="FfmpegDot" Width="6" Height="6" Fill="{StaticResource Faint}" VerticalAlignment="Center" />
              <TextBlock x:Name="FfmpegText" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Text="FFmpeg" />
            </StackPanel>
          </StackPanel>
          <c:ThemePicker x:Name="ThemePick" VerticalAlignment="Center" />
          <Button x:Name="SettingsButton" Classes="ghost" ToolTip.Tip="Configuración">
            <TextBlock Classes="icon" Text="&#xE713;" />
          </Button>
        </StackPanel>

        <Button Grid.Column="5" x:Name="ExportButton" Classes="accent" ToolTip.Tip="Exportar MP4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Classes="icon" Text="&#xE72D;" FontSize="12" Foreground="{StaticResource AccentFg}" />
            <TextBlock x:Name="ExportButtonText" Text="Exportar MP4" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- inspector ("Toma"; folds to a column of icons in MainWindow.Inspector.cs) + preview -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <Border x:Name="InspectorBar" Width="290" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel x:Name="Inspector" Margin="14,16" Spacing="12" />
        </ScrollViewer>
      </Border>

      <!-- the stage and, beside it, the "En vivo" monitor (the web's aside next to SplitScreenCanvas) -->
      <Grid Grid.Column="1" x:Name="StageArea" ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
        <!-- format: layout on the left, aspect ratio on the right (App.tsx, above SplitScreenCanvas) -->
        <DockPanel Grid.ColumnSpan="2" Margin="16,12,16,0">
          <Border Classes="seg" DockPanel.Dock="Left">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="LayoutSideButton" Classes="seg" ToolTip.Tip="Paneles uno al lado del otro">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M1.5,1.5 H12.5 V12.5 H1.5 Z M7,1.5 V12.5" Stroke="{Binding #LayoutSideText.Foreground}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock x:Name="LayoutSideText" Text="Lado a lado" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="LayoutStackButton" Classes="seg" ToolTip.Tip="Paneles uno arriba del otro">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M1.5,1.5 H12.5 V12.5 H1.5 Z M1.5,7 H12.5" Stroke="{Binding #LayoutStackText.Foreground}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock x:Name="LayoutStackText" Text="Apilado" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Border>
          <Border Classes="seg" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="Aspect169Button" Classes="seg" ToolTip.Tip="Horizontal (YouTube)"><TextBlock Classes="mono" Text="16:9" /></ToggleButton>
              <ToggleButton x:Name="Aspect916Button" Classes="seg" ToolTip.Tip="Vertical (Reels / Shorts / TikTok)"><TextBlock Classes="mono" Text="9:16" /></ToggleButton>
              <ToggleButton x:Name="Aspect11Button" Classes="seg" ToolTip.Tip="Cuadrado"><TextBlock Classes="mono" Text="1:1" /></ToggleButton>
            </StackPanel>
          </Border>
        </DockPanel>
        <c:PreviewView Grid.Row="1" x:Name="Preview" />
        <c:LiveMonitor Grid.Row="1" Grid.Column="1" x:Name="Live" Width="256" Margin="0,16,16,16" VerticalAlignment="Top" />
      </Grid>
      <!-- solo audio: the timeline (or the mixer) moves up here, in the stage's place (MainWindow.Mode.cs) -->
      <Panel Grid.Column="1" x:Name="AudioArea" IsVisible="False" Background="{StaticResource App}" />
    </Grid>

    <!-- project bar (Color / Historial): the web's right sidebar, beside the stage and the timeline; filled in MainWindow.Color.cs -->
    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" x:Name="ProjectBar" Width="290" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" />

    <GridSplitter x:Name="BottomSplitter" Grid.Row="2" ToolTip.Tip="Arrastrá para cambiar la altura de la timeline" Background="{StaticResource Line}" ResizeDirection="Rows" />

    <!-- timeline, or the mixer in its place (X) -->
    <DockPanel Grid.Row="3" x:Name="MixerHost" IsVisible="False" Background="{StaticResource App}" />
    <Grid Grid.Row="3" x:Name="TimelineHost">
      <c:TimelineView x:Name="Timeline" />
      <!-- the corner above the track headers, like the web: ruler mode, snap, fit and track height -->
      <Grid x:Name="TimelineToolbar" Width="264" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{StaticResource Panel}" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0">
        <!-- ruler mode: notes = bars and beats, clock = minutes and seconds; the active one on AccentSoft -->
        <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="8,0,6,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="BarsRulerButton" Classes="ghost" Width="26" Height="22" Padding="0" MinWidth="0" CornerRadius="4"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Regla en compases y tiempos (4/4, al tempo del click)">
              <TextBlock Classes="icon" Text="&#xEC4F;" FontSize="14" />
            </Button>
            <Button x:Name="TimeRulerButton" Classes="ghost" Width="26" Height="22" Padding="0" MinWidth="0" CornerRadius="4"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Regla en minutos y segundos">
              <TextBlock Classes="icon" Text="&#xE823;" FontSize="14" />
            </Button>
          </StackPanel>
        </Border>
        <!-- snap: the magnet lights up with the accent while clips, the playhead, trims and fades stick to the grid -->
        <Panel Grid.Column="1" x:Name="SnapPanel" Width="90" Height="28" VerticalAlignment="Center">
          <c:SelectButton x:Name="SnapBox" Classes="snap" Width="90" Height="28" Padding="25,0,6,0" CornerRadius="6" AutomationProperties.Name="Imán a la grilla" />
          <PathIcon x:Name="SnapIcon" Data="{StaticResource MagnetIcon}" Width="13" Height="13" Margin="8,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Panel>
        <Button Grid.Column="3" x:Name="TimelineFitButton" Classes="ghost" Width="28" Height="28" Padding="0" MinWidth="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Ver todo (ajustar el zoom al ancho) (F)">
          <TextBlock Classes="icon" Text="&#xE9A6;" FontSize="14" />
        </Button>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="2,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Altura de las pistas (Alt+rueda)">
          <TextBlock Classes="icon" Text="&#xE8FD;" FontSize="13" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
          <!-- the web's .slider: 4 px track and a 14 px light thumb -->
          <Slider x:Name="TrackHeightSlider" Width="44" Minimum="40" Maximum="160" Value="64" TickFrequency="2" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center" AutomationProperties.Name="Altura de las pistas">
            <Slider.Resources>
              <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
              <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
              <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
              <SolidColorBrush x:Key="SliderThumbBackground" Color="#f4f4f5" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#ffffff" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#ffffff" />
            </Slider.Resources>
          </Slider>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- transport bar, always at the bottom (Fender Studio Pro style, asked by the user). The clock, the
         transport and the metronome share one dark box that stays centered on the window: the side columns
         are equal stars, the audio status on the left trims its text before the box moves. -->
    <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,6">
      <Grid ColumnDefinitions="*,Auto,*">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,16,0" VerticalAlignment="Center" ClipToBounds="True">
          <StackPanel Classes="bar-cell" Width="44" Margin="0,0,16,0" ToolTip.Tip="Carga del callback de audio">
            <TextBlock x:Name="DspText" Classes="mono metro-value" Text="—" />
            <TextBlock Classes="metro-label" Text="DSP" />
          </StackPanel>
          <StackPanel Grid.Column="1" x:Name="AudioCell" Classes="bar-cell" HorizontalAlignment="Left" Margin="0,0,16,0">
            <TextBlock x:Name="AudioStatus" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,2" />
            <TextBlock x:Name="AudioDriverText" Classes="metro-label" Text="Audio" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Classes="bar-cell">
            <c:StereoMeter x:Name="InputMeter" Width="110" Margin="0,1,0,3" />
            <TextBlock Classes="metro-label" Text="Entrada 1-2" />
          </StackPanel>
        </Grid>

        <Border Grid.Column="1" Classes="metro">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ClockButton" Classes="clock">
              <StackPanel>
                <TextBlock x:Name="TimeText" Classes="mono" FontSize="19" Text="1.1.1" HorizontalAlignment="Center" />
                <TextBlock x:Name="BarText" Classes="mono" Foreground="{StaticResource Faint}" FontSize="10" Text="/ 1.1.1" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Classes="vsep" />
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0">
              <Button x:Name="ToStartButton" Classes="tbtn" ToolTip.Tip="Volver al inicio (Inicio)">
                <TextBlock Classes="icon" Text="&#xF8AC;" FontSize="15" />
              </Button>
              <Button x:Name="StopButton" Classes="tbtn" ToolTip.Tip="Detener (vuelve a donde arrancó; si ya está detenido, al inicio)">
                <TextBlock Classes="icon" Text="&#xE73B;" FontSize="14" />
              </Button>
              <Button x:Name="PlayButton" Classes="tbtn" ToolTip.Tip="Reproducir desde el cabezal (Espacio)">
                <TextBlock x:Name="PlayIcon" Classes="icon" Text="&#xF5B0;" FontSize="17" />
              </Button>
              <!-- a plain transport button (pedido del usuario; in the web it is a big chip with its target):
                   the track it records to is the one tinted red in the timeline and the mixer -->
              <Button x:Name="RecButton" Classes="tbtn" ToolTip.Tip="Grabar en una pista nueva al final (R)">
                <Ellipse Width="13" Height="13" Fill="{StaticResource Rec}" />
              </Button>
              <Button x:Name="RecStopButton" Classes="chip rec-stop" Height="30" Padding="12,0,16,0" IsVisible="False" Background="{StaticResource Rec}" BorderBrush="{StaticResource Rec}" Foreground="White" ToolTip.Tip="Detener y guardar la toma (Espacio / R)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" Text="&#xE73B;" FontSize="13" Foreground="White" />
                  <TextBlock Text="Detener" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
              </Button>
              <Button x:Name="RecDiscardButton" Classes="chip discard" Height="30" Padding="12,0" IsVisible="False" Background="Transparent" ToolTip.Tip="Parar sin guardar esta toma">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE74D;" FontSize="13" />
                  <TextBlock Text="Descartar" FontSize="14" />
                </StackPanel>
              </Button>
              <Button x:Name="CountCancelButton" Classes="chip count" Height="30" Padding="12,0,16,0" IsVisible="False" Foreground="{StaticResource Fg}" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent50}" ToolTip.Tip="Cancelar la cuenta (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" Text="&#xE711;" FontSize="14" />
                  <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="CountBeatText" Classes="mono" Foreground="{StaticResource Accent}" FontSize="14" Text="1/4" />
                </StackPanel>
              </Button>
              <ToggleButton x:Name="LoopToggle" Classes="tbtn" IsChecked="True" ToolTip.Tip="Repetir en loop">
                <TextBlock Classes="icon" Text="&#xE8EE;" FontSize="16" />
              </ToggleButton>
            </StackPanel>
            <Border Classes="vsep" />
            <!-- metronome (Studio One style, asked by the user instead of the web's separate chips) -->
            <StackPanel Classes="metro-cell" ToolTip.Tip="Compás: por ahora siempre 4/4">
              <TextBlock Classes="mono metro-value" Text="4/4" />
              <TextBlock Classes="metro-label" Text="Compás" />
            </StackPanel>
            <c:TempoControl x:Name="Tempo" Height="38" BorderThickness="0" CornerRadius="0" Background="Transparent" />
            <ToggleButton x:Name="CountInToggle" Classes="cell" IsChecked="True" ToolTip.Tip="Cuenta de 4 tiempos antes de grabar (Shift+C)">
              <StackPanel>
                <TextBlock Classes="mono metro-value" Text="1234" LetterSpacing="1" />
                <TextBlock Classes="metro-label" Text="Cuenta" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ClickToggle" Classes="cell" ToolTip.Tip="Metrónomo al grabar y al reproducir (C)">
              <StackPanel>
                <PathIcon Data="{StaticResource MetronomeIcon}" Width="15" Height="15" Margin="0,0,0,2" />
                <TextBlock Classes="metro-label" Text="Click" />
              </StackPanel>
            </ToggleButton>
            <Button x:Name="ClickSoundButton" Classes="cell" Width="24" Padding="0" Margin="-4,0,0,0" ToolTip.Tip="Sonido del click: Bip">
              <TextBlock Classes="icon" Text="&#xE70D;" FontSize="10" />
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
          <Border Classes="seg" ToolTip.Tip="Alternar timeline / mixer (X)">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TimelineViewButton" Classes="seg on" Height="32" Padding="12,0" Content="Timeline" />
              <Button x:Name="MixerViewButton" Classes="seg" Height="32" Padding="12,0" Content="Mixer" />
            </StackPanel>
          </Border>
          <Button x:Name="FitButton" Classes="tbtn" ToolTip.Tip="Ver todo (F)">
            <TextBlock Classes="icon" Text="&#xE9A6;" FontSize="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- the "Proyectos" manager covers the whole window, like in the web app -->
    <c:ProjectsDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="Projects" IsVisible="False" />
    <d:ExportDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="Export" IsVisible="False" AutomationProperties.Name="Exportar video" />
    <d:SettingsDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="Settings" IsVisible="False" />
    <d:AboutDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="About" IsVisible="False" />
  </Grid>
</Window>
