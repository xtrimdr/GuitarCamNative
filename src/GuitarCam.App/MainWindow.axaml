<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GuitarCam.App.Controls"
        xmlns:d="using:GuitarCam.App.Dialogs"
        xmlns:loc="using:GuitarCam.App"
        x:Class="GuitarCam.App.MainWindow"
        Title="GuitarCam Studio Native"
        Icon="/Assets/GuitarCam.ico"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="None"
        Background="{StaticResource App}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome">

  <!-- TransparencyLevelHint None: with transparency allowed, some dark video pixels let the window behind show through -->
  <Window.Styles>
    <!-- the window's panels (inspector, project bar, timeline, mixer) are cards set apart from the window's background
         (asked by the user, to see where each one starts and ends). A panel whose content paints to its edges
         clips it with "card-clip" and draws its edge with "card-edge" on top: the edge of a clipping Border
         is drawn under its child, which would hide it at the corners -->
    <Style Selector="Border.card">
      <Setter Property="Margin" Value="4" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.card-clip">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.card-edge">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.section.off TextBlock.dim, Border.section.off Slider, Border.section.off UniformGrid, Border.section.off CheckBox">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- the thin vertical lines between the groups of the top bar's status (CPU… · DSP · audio · camera · FFmpeg) -->
    <Style Selector="Border.tsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Background" Value="{StaticResource Line}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.tstat TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- the project's mode switch, beside the app's name: a recessed track on the bar with the chosen mode lit in
         the accent (tint, border, text and icon) and the other one dim, so which mode is on reads at a glance -->
    <Style Selector="Border.mode">
      <Setter Property="Background" Value="{StaticResource App}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.mode">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.mode:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
    </Style>
    <Style Selector="ToggleButton.mode:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.mode:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.mode:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent50}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.mode:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.mode:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent50}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.mode:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </Window.Styles>

  <!-- maximized, Windows pushes a window with our own title bar 8 px past each screen edge: OffScreenMargin
       says how much, so the content stays on screen -->
  <Grid x:Name="Root" RowDefinitions="Auto,*,0,280,Auto" ColumnDefinitions="*,Auto" Margin="{Binding $parent[Window].OffScreenMargin}">

    <!-- top bar: two rows so everything fits in a window that is not maximized. The first is the window's title
         bar (the system buttons sit on its right); the second holds the project's tools, Exportar on the right -->
    <Border x:Name="TitleBar" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid RowDefinitions="44,Auto">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,150,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="LogoButton" Classes="ghost" Padding="2" Margin="-2,0" ToolTip.Tip="{loc:T title.about.tip}" AutomationProperties.Name="{loc:T title.about}">
              <Image Source="/Assets/GuitarCam-64.png" Width="24" Height="24" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Button>
            <TextBlock Text="GuitarCam Studio" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
            <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
              <TextBlock Text="NATIVE" FontSize="9.5" FontWeight="Bold" LetterSpacing="0.8" Foreground="{StaticResource Accent}" />
            </Border>
            <!-- a copy made by tools\probar.ps1 says which build it is (TestBuild) -->
            <Border x:Name="TestBuildChip" Background="{StaticResource Hover}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{loc:T title.test}" FontSize="9.5" FontWeight="Bold" LetterSpacing="0.8" Foreground="{StaticResource Dim}" />
                <TextBlock x:Name="TestBuildText" Classes="mono" FontSize="9.5" Foreground="{StaticResource Dim}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="0" VerticalAlignment="Center">
            <!-- system load, the audio engine's DSP load, camera and FFmpeg (the web's text-[11px] text-faint group;
                 the DSP load came up here from the transport bar, asked by the user) -->
            <StackPanel x:Name="SystemInfo" Classes="tstat" Orientation="Horizontal" Spacing="10" Margin="0,0,6,0" VerticalAlignment="Center">
              <c:SystemMeter x:Name="SysMeter" />
              <Border x:Name="SysMeterSep" Classes="tsep" />
              <!-- the audio callback's load, drawn like CPU / GPU / RAM: name, number, bar -->
              <StackPanel Orientation="Horizontal" Spacing="5" Background="Transparent" ToolTip.Tip="{loc:T title.dsp.tip}">
                <TextBlock Text="DSP" Foreground="{StaticResource Faint}" />
                <TextBlock x:Name="DspText" Classes="mono" Foreground="{StaticResource Dim}" Width="26" Text="–" />
                <Border Width="32" Height="5" CornerRadius="3" Background="{StaticResource Raised}" ClipToBounds="True" VerticalAlignment="Center">
                  <Border x:Name="DspFill" CornerRadius="3" HorizontalAlignment="Left" Width="0" Background="{StaticResource Accent}" />
                </Border>
              </StackPanel>
              <!-- FFmpeg only shows here when it is missing; its version is in "Acerca de" -->
              <Border x:Name="FfmpegSep" Classes="tsep" IsVisible="False" />
              <StackPanel x:Name="FfmpegState" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Background="Transparent" IsVisible="False" ToolTip.Tip="{loc:T title.ffmpeg.looking}">
                <Ellipse x:Name="FfmpegDot" Width="6" Height="6" Fill="{StaticResource Faint}" VerticalAlignment="Center" />
                <TextBlock x:Name="FfmpegText" Foreground="{StaticResource Faint}" Text="FFmpeg" />
              </StackPanel>
            </StackPanel>
            <c:NotificationBell x:Name="Bell" VerticalAlignment="Center" />
            <!-- the window's layout: Clásico / Vertical (MainWindow.Layout.cs) -->
            <Button x:Name="LayoutButton" Classes="ghost" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{loc:T winlayout.title}" AutomationProperties.Name="{loc:T winlayout.title}">
              <TextBlock Classes="icon" Text="&#xE80A;" />
            </Button>
            <c:ThemePicker x:Name="ThemePick" VerticalAlignment="Center" />
            <Button x:Name="SettingsButton" Classes="ghost" ToolTip.Tip="{loc:T settings.title}">
              <TextBlock Classes="icon" Text="&#xE713;" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" x:Name="ProjectRow" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0,12,8">
          <!-- the project's mode (native only): video, or solo audio without stage, camera or MP4; first in the row so
               the kind of project is the first thing read -->
          <Border Classes="mode" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton x:Name="ModeVideoButton" Classes="mode" ToolTip.Tip="{loc:T mode.video.tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE714;" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock x:Name="ModeVideoText" Text="{loc:T mode.video}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ModeAudioButton" Classes="mode" ToolTip.Tip="{loc:T mode.audio.tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE8D6;" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock x:Name="ModeAudioText" Text="{loc:T mode.audio}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Border>

          <Button Grid.Column="1" x:Name="SessionChip" Classes="ghost" Foreground="{StaticResource Fg}" Height="32" Padding="10,0" VerticalContentAlignment="Center" FontSize="12" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon" Text="&#xE8B7;" FontSize="13" Foreground="{StaticResource Dim}" />
              <TextBlock x:Name="SessionName" Text="{loc:T title.noProject}" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
              <!-- save state (the web's Guardando / Guardado / Error al guardar next to the name) -->
              <StackPanel x:Name="SaveState" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
                <Arc x:Name="SaveSpin" Classes="spin" Width="11" Height="11" StrokeThickness="1.5" Stroke="{StaticResource Dim}" IsVisible="False" />
                <TextBlock x:Name="SaveIcon" Classes="icon" Text="&#xE73E;" FontSize="10" Foreground="{StaticResource Faint}" />
                <TextBlock x:Name="SaveText" Text="{loc:T title.saved}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Faint}" />
              </StackPanel>
              <TextBlock Classes="icon" Text="&#xE70D;" FontSize="9" Foreground="{StaticResource Faint}" />
            </StackPanel>
          </Button>

          <!-- edit tools, set apart from the project chip by a line -->
          <StackPanel Grid.Column="2" x:Name="EditButtons" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
            <Border Classes="tsep" Margin="0,0,8,0" />
            <!-- save now (native only): what the "Guardado" mode leaves pending, by hand -->
            <Button x:Name="SaveButton" Classes="ghost" IsEnabled="False" ToolTip.Tip="{loc:T title.save.tip}" AutomationProperties.Name="{loc:T title.save.tip}">
              <TextBlock Classes="icon" Text="&#xE74E;" />
            </Button>
            <Button x:Name="UndoButton" Classes="ghost" IsEnabled="False" ToolTip.Tip="{loc:T title.undo}">
              <TextBlock Classes="icon" Text="&#xE7A7;" />
            </Button>
            <Button x:Name="RedoButton" Classes="ghost" IsEnabled="False" ToolTip.Tip="{loc:T title.redo}">
              <TextBlock Classes="icon" Text="&#xE7A6;" />
            </Button>
          </StackPanel>

          <!-- the timeline's tools (native only, asked by the user): centered on the window, like the transport, and
               pushed aside only when the window is too narrow (MainWindow.Tools.cs); same recessed track as the mode -->
          <Border Grid.Column="3" x:Name="ToolBox" Classes="mode" HorizontalAlignment="Left">
            <StackPanel x:Name="ToolStrip" Orientation="Horizontal" Spacing="2" />
          </Border>

          <Button Grid.Column="4" x:Name="ExportButton" Classes="accent" ToolTip.Tip="{loc:T export.mp4}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <!-- a download arrow: the file lands in exports/ -->
                <TextBlock Classes="icon" Text="&#xE896;" FontSize="13" />
              <TextBlock x:Name="ExportButtonText" Text="{loc:T export.mp4}" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <!-- inspector ("Canal"; folds to a column of icons in MainWindow.Inspector.cs) + preview; the window's layout
         (MainWindow.Layout.cs) rearranges its columns -->
    <Grid Grid.Row="1" x:Name="Workspace" ColumnDefinitions="Auto,*">
      <Border x:Name="InspectorBar" Classes="card" Width="290" ZIndex="1" Background="{StaticResource Panel}">
        <ScrollViewer>
          <StackPanel x:Name="Inspector" Margin="14,16" Spacing="12" />
        </ScrollViewer>
      </Border>

      <!-- the stage and, beside it, the "En vivo" monitor (the web's aside next to SplitScreenCanvas) -->
      <Grid Grid.Column="1" x:Name="StageArea" ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
        <!-- format: layout on the left, aspect ratio on the right (App.tsx, above SplitScreenCanvas) -->
        <DockPanel Grid.ColumnSpan="2" Margin="16,12,16,0">
          <Border Classes="seg" DockPanel.Dock="Left">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="LayoutSideButton" Classes="seg" ToolTip.Tip="{loc:T layout.side.tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M1.5,1.5 H12.5 V12.5 H1.5 Z M7,1.5 V12.5" Stroke="{Binding #LayoutSideText.Foreground}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock x:Name="LayoutSideText" Text="{loc:T layout.side}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="LayoutStackButton" Classes="seg" ToolTip.Tip="{loc:T layout.stack.tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M1.5,1.5 H12.5 V12.5 H1.5 Z M1.5,7 H12.5" Stroke="{Binding #LayoutStackText.Foreground}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock x:Name="LayoutStackText" Text="{loc:T layout.stack}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Border>
          <Border Classes="seg" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="Aspect169Button" Classes="seg" ToolTip.Tip="Horizontal (YouTube)"><TextBlock Classes="mono" Text="16:9" /></ToggleButton>
              <ToggleButton x:Name="Aspect916Button" Classes="seg" ToolTip.Tip="Vertical (Reels / Shorts / TikTok)"><TextBlock Classes="mono" Text="9:16" /></ToggleButton>
              <ToggleButton x:Name="Aspect11Button" Classes="seg" ToolTip.Tip="Cuadrado"><TextBlock Classes="mono" Text="1:1" /></ToggleButton>
            </StackPanel>
          </Border>
        </DockPanel>
        <c:PreviewView Grid.Row="1" x:Name="Preview" />
        <c:LiveMonitor Grid.Row="1" Grid.Column="1" x:Name="Live" Width="256" Margin="0,16,16,16" VerticalAlignment="Top" />
      </Grid>
      <!-- solo audio: the timeline (or the mixer) moves up here, in the stage's place (MainWindow.Mode.cs) -->
      <Grid Grid.Column="1" x:Name="AudioArea" IsVisible="False" RowDefinitions="*,0,0" Background="{StaticResource App}">
        <!-- the splitters sit in a row of 0 and take the gap between the cards (their margins) -->
        <GridSplitter x:Name="AudioSplitter" Grid.Row="1" IsVisible="False" ToolTip.Tip="{loc:T splitter.mixer}" Background="Transparent" Margin="0,-4" ResizeDirection="Rows" />
      </Grid>
    </Grid>

    <!-- project bar (Color / Historial): the web's right sidebar, beside the stage and the timeline; filled in MainWindow.Color.cs -->
    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" x:Name="ProjectBar" Classes="card" Width="290" Background="{StaticResource Panel}" />

    <GridSplitter x:Name="BottomSplitter" Grid.Row="2" ToolTip.Tip="{loc:T splitter.timeline}" Background="Transparent" Margin="0,-4" ResizeDirection="Rows" />

    <!-- timeline, or the mixer in its place (X) -->
    <Panel Grid.Row="3" x:Name="MixerHost" IsVisible="False" Margin="4">
      <Border Classes="card-clip" Background="{StaticResource App}">
        <DockPanel x:Name="MixerDock" />
      </Border>
      <Border Classes="card-edge" />
    </Panel>
    <Grid Grid.Row="3" x:Name="TimelineHost" Margin="4">
      <Border Classes="card-clip">
        <Grid>
          <c:TimelineView x:Name="Timeline" />
          <!-- the corner above the track headers: ruler mode, snap, fit and clearing mutes / solos -->
          <Grid x:Name="TimelineToolbar" Width="324" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{StaticResource Panel}" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0">
            <!-- ruler mode: notes = bars and beats, clock = minutes and seconds; the active one on AccentSoft -->
            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="8,0,6,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="BarsRulerButton" Classes="ghost" Width="26" Height="22" Padding="0" MinWidth="0" CornerRadius="4"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="{loc:T ruler.bars.tip}">
                  <TextBlock Classes="icon" Text="&#xEC4F;" FontSize="14" />
                </Button>
                <Button x:Name="TimeRulerButton" Classes="ghost" Width="26" Height="22" Padding="0" MinWidth="0" CornerRadius="4"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="{loc:T ruler.time.tip}">
                  <TextBlock Classes="icon" Text="&#xE823;" FontSize="14" />
                </Button>
              </StackPanel>
            </Border>
            <!-- snap: the magnet lights up with the accent while clips, the playhead, trims and fades stick to the grid -->
            <Panel Grid.Column="1" x:Name="SnapPanel" Width="86" Height="28" VerticalAlignment="Center">
              <c:SelectButton x:Name="SnapBox" Classes="snap" Width="86" Height="28" Padding="25,0,6,0" CornerRadius="6" AutomationProperties.Name="{loc:T snap.name}" />
              <PathIcon x:Name="SnapIcon" Data="{StaticResource MagnetIcon}" Width="13" Height="13" Margin="8,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Panel>
            <!-- snap to other clips (asked by the user): which edges of a moved clip stick to theirs, a selector like the
                 snap's, lit the same way while it is on (MainWindow.Timeline.cs ShowSnap) -->
            <Panel Grid.Column="2" x:Name="SnapClipsPanel" Width="72" Height="28" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
              <c:SelectButton x:Name="SnapClipsBox" Classes="snap" Width="72" Height="28" Padding="25,0,6,0" CornerRadius="6" AutomationProperties.Name="{loc:T snap.clips.name}" />
              <PathIcon x:Name="SnapClipsIcon" Data="{StaticResource SnapClipsIcon}" Width="13" Height="13" Margin="8,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Panel>
            <Button Grid.Column="3" x:Name="TimelineFitButton" Classes="ghost" Width="28" Height="28" Padding="0" MinWidth="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="{loc:T timeline.fit.tip}">
              <TextBlock Classes="icon" Text="&#xE9A6;" FontSize="14" />
            </Button>
            <!-- Cubase's "deactivate all mute / solo states" (native only): lit while any track has one (MainWindow.Timeline.cs) -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
              <Button x:Name="ClearMutesButton" Classes="chip" Width="24" Height="24" MinHeight="24" Padding="0" CornerRadius="4"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{loc:T timeline.noMutes}">
                <TextBlock Text="M" FontSize="10.5" FontWeight="SemiBold" />
              </Button>
              <Button x:Name="ClearSolosButton" Classes="chip" Width="24" Height="24" MinHeight="24" Padding="0" CornerRadius="4"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{loc:T timeline.noSolos}">
                <TextBlock Text="S" FontSize="10.5" FontWeight="SemiBold" />
              </Button>
            </StackPanel>
          </Grid>
          <!-- the zoom bar at the foot of the track headers (asked by the user): horizontal zoom and track height, each
               with its slider, made big and easy to grab (asked by the user): 6 px track and an 18 px light thumb; wired in MainWindow.Timeline.cs. Its height is TimelineView.FooterH. -->
          <Border x:Name="TimelineFooter" Width="324" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
            <Border.Resources>
              <x:Double x:Key="SliderHorizontalThumbWidth">18</x:Double>
              <x:Double x:Key="SliderHorizontalThumbHeight">18</x:Double>
              <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
              <SolidColorBrush x:Key="SliderThumbBackground" Color="#f4f4f5" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#ffffff" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#ffffff" />
            </Border.Resources>
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="12,0,6,0">
              <TextBlock x:Name="ZoomIcon" Classes="icon" Text="&#xE8A3;" FontSize="15" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                      VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.Name="{loc:T timeline.zoom}" />
              <TextBlock x:Name="HeightIcon" Grid.Column="2" Classes="icon" Text="&#xE8FD;" FontSize="15" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider x:Name="TrackHeightSlider" Grid.Column="3" Minimum="40" Maximum="320" Value="64" TickFrequency="2" IsSnapToTickEnabled="True"
                      VerticalAlignment="Center" AutomationProperties.Name="{loc:T timeline.height}" />
              <!-- native only: every track and folder back to the shared height (rows get their own by dragging their bottom edge) -->
              <Button x:Name="ResetHeightsButton" Grid.Column="4" Classes="ghost" Width="30" Height="30" MinHeight="0" Padding="0" Margin="8,0,0,0"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="False"
                      AutomationProperties.Name="{loc:T timeline.resetHeights}" ToolTip.Tip="{loc:T timeline.resetHeights.tip}">
                <TextBlock Classes="icon" Text="&#xE72C;" FontSize="14" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Border Classes="card-edge" />
    </Grid>

    <!-- transport bar, always at the bottom (Fender Studio Pro style, asked by the user). The clock, the
         transport and the metronome share one dark box that stays centered on the window: the side columns
         are equal stars, the audio status on the left trims its text before the box moves. -->
    <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,6">
      <Grid ColumnDefinitions="*,Auto,*">
        <!-- the input: its meter with the audio format under it, and software monitoring on / off, next to the transport -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center">
          <StackPanel x:Name="AudioCell" Classes="bar-cell" Background="Transparent">
            <!-- as wide as the line under it, with its dB scale -->
            <c:StereoMeter x:Name="InputMeter" ShowScale="True" Margin="0,1,0,2" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="metro-label" Text="{loc:T transport.input}" />
              <TextBlock x:Name="AudioStatus" Classes="metro-label mono" />
            </StackPanel>
          </StackPanel>
          <ToggleButton x:Name="MonitorToggle" Classes="cell" CornerRadius="6" ToolTip.Tip="{loc:T transport.monitor.tip}">
            <StackPanel>
              <TextBlock Classes="icon" Text="&#xE7F6;" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,2" />
              <TextBlock Classes="metro-label" Text="{loc:T transport.monitor}" />
            </StackPanel>
          </ToggleButton>
          <!-- the tuner (native only): the cell shows the note, the panel over it the needle -->
          <ToggleButton x:Name="TunerToggle" Classes="cell" CornerRadius="6" MinWidth="52">
            <StackPanel>
              <TextBlock x:Name="TunerNote" Classes="mono metro-value" Text="♪" HorizontalAlignment="Center" />
              <TextBlock Classes="metro-label" Text="{loc:T transport.tuner}" />
            </StackPanel>
          </ToggleButton>
          <!-- light dismiss: a click outside closes it (and is not passed on, so a click on the cell only closes) -->
          <Popup x:Name="TunerPopup" PlacementTarget="{Binding #TunerToggle}" Placement="Top" VerticalOffset="-8" IsLightDismissEnabled="True">
            <Border x:Name="TunerPanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
              <StackPanel x:Name="TunerBody" Spacing="10">
                <TextBlock Classes="label" Text="{loc:T tuner.title}" />
                <c:TunerView x:Name="Tuner" />
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>

        <Border Grid.Column="1" Classes="metro">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ClockButton" Classes="clock">
              <StackPanel>
                <TextBlock x:Name="TimeText" Classes="mono" FontSize="19" Text="1.1.1" HorizontalAlignment="Center" />
                <TextBlock x:Name="BarText" Classes="mono" Foreground="{StaticResource Faint}" FontSize="10" Text="/ 1.1.1" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Classes="vsep" />
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0">
              <Button x:Name="ToStartButton" Classes="tbtn" ToolTip.Tip="{loc:T transport.start.tip}">
                <TextBlock Classes="icon" Text="&#xF8AC;" FontSize="15" />
              </Button>
              <Button x:Name="StopButton" Classes="tbtn" ToolTip.Tip="{loc:T transport.stop.tip}">
                <TextBlock Classes="icon" Text="&#xE73B;" FontSize="14" />
              </Button>
              <Button x:Name="PlayButton" Classes="tbtn" ToolTip.Tip="{loc:T transport.play.tip}">
                <TextBlock x:Name="PlayIcon" Classes="icon" Text="&#xF5B0;" FontSize="17" />
              </Button>
              <!-- a plain transport button (pedido del usuario; in the web it is a big chip with its target):
                   the track it records to is the one tinted red in the timeline and the mixer -->
              <Button x:Name="RecButton" Classes="tbtn" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{loc:T transport.rec.arm.tip}">
                <Ellipse Width="13" Height="13" Fill="{StaticResource Rec}" />
              </Button>
              <Button x:Name="RecStopButton" Classes="chip rec-stop" Height="30" Padding="12,0,16,0" IsVisible="False" Background="{StaticResource Rec}" BorderBrush="{StaticResource Rec}" Foreground="White" ToolTip.Tip="{loc:T transport.rec.stop.tip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" Text="&#xE73B;" FontSize="13" Foreground="White" />
                  <TextBlock Text="{loc:T transport.rec.stop}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
              </Button>
              <Button x:Name="RecDiscardButton" Classes="chip discard" Height="30" Padding="12,0" IsVisible="False" Background="Transparent" ToolTip.Tip="{loc:T transport.rec.discard.tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="icon" Text="&#xE74D;" FontSize="13" />
                  <TextBlock Text="{loc:T transport.rec.discard}" FontSize="14" />
                </StackPanel>
              </Button>
              <Button x:Name="CountCancelButton" Classes="chip count" Height="30" Padding="12,0,16,0" IsVisible="False" Foreground="{StaticResource Fg}" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent50}" ToolTip.Tip="{loc:T transport.count.cancel.tip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" Text="&#xE711;" FontSize="14" />
                  <TextBlock Text="{loc:T transport.count.cancel}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="CountBeatText" Classes="mono" Foreground="{StaticResource Accent}" FontSize="14" Text="1/4" />
                </StackPanel>
              </Button>
              <ToggleButton x:Name="LoopToggle" Classes="tbtn" IsChecked="True" ToolTip.Tip="{loc:T transport.loop.tip}">
                <TextBlock Classes="icon" Text="&#xE8EE;" FontSize="16" />
              </ToggleButton>
            </StackPanel>
            <Border Classes="vsep" />
            <!-- metronome (Studio One style, asked by the user instead of the web's separate chips) -->
            <StackPanel Classes="metro-cell" ToolTip.Tip="{loc:T transport.meter.tip}">
              <TextBlock Classes="mono metro-value" Text="4/4" />
              <TextBlock Classes="metro-label" Text="{loc:T transport.meter}" />
            </StackPanel>
            <c:TempoControl x:Name="Tempo" Height="38" BorderThickness="0" CornerRadius="0" Background="Transparent" />
            <ToggleButton x:Name="CountInToggle" Classes="cell" IsChecked="True" ToolTip.Tip="{loc:T transport.countin.tip}">
              <StackPanel>
                <TextBlock Classes="mono metro-value" Text="1234" LetterSpacing="1" />
                <TextBlock Classes="metro-label" Text="{loc:T transport.countin}" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ClickToggle" Classes="cell" ToolTip.Tip="{loc:T transport.click.tip}">
              <StackPanel>
                <PathIcon Data="{StaticResource MetronomeIcon}" Width="15" Height="15" Margin="0,0,0,2" />
                <TextBlock Classes="metro-label" Text="{loc:T transport.click}" />
              </StackPanel>
            </ToggleButton>
            <Button x:Name="ClickSoundButton" Classes="cell" Width="24" Padding="0" Margin="-4,0,0,0" ToolTip.Tip="{loc:T transport.click.sound.tip}">
              <TextBlock Classes="icon" Text="&#xE70D;" FontSize="10" />
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
          <!-- the master's integrated loudness while it plays (native only); a click starts it over -->
          <Button x:Name="LufsCell" Classes="cell" CornerRadius="6" MinWidth="56">
            <StackPanel>
              <TextBlock x:Name="LufsText" Classes="mono metro-value" Text="—" HorizontalAlignment="Center" />
              <TextBlock Classes="metro-label" Text="LUFS" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border x:Name="ViewSwitch" Classes="seg" ToolTip.Tip="{loc:T transport.view.tip}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TimelineViewButton" Classes="seg on" Height="32" Padding="12,0" Content="{loc:T transport.view.timeline}" />
              <Button x:Name="PianoViewButton" Classes="seg" Height="32" Padding="12,0" Content="{loc:T transport.view.piano}" />
              <Button x:Name="MixerViewButton" Classes="seg" Height="32" Padding="12,0" Content="{loc:T transport.view.mixer}" />
              <Button x:Name="MasteringViewButton" Classes="seg" Height="32" Padding="12,0" Content="{loc:T transport.view.mastering}" />
            </StackPanel>
          </Border>
          <Button x:Name="FitButton" Classes="tbtn" ToolTip.Tip="{loc:T transport.fit.tip}">
            <TextBlock Classes="icon" Text="&#xE9A6;" FontSize="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- the "Proyectos" manager covers the whole window, like in the web app -->
    <c:ProjectsDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="Projects" IsVisible="False" />
    <d:ExportDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="Export" IsVisible="False" AutomationProperties.Name="{loc:T export.name}" />
    <d:SettingsDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="Settings" IsVisible="False" />
    <d:AboutDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="About" IsVisible="False" />
    <d:UnsavedDialog Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="Unsaved" IsVisible="False" />
    <!-- toasts float over everything (the manager and the dialogs too), above the transport bar -->
    <c:ToastHost Grid.RowSpan="5" Grid.ColumnSpan="2" x:Name="Toasts" Margin="0,0,16,68" />
  </Grid>
</Window>
