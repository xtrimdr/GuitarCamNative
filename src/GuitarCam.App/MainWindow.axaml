<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GuitarCam.App.Controls"
        xmlns:d="using:GuitarCam.App.Dialogs"
        x:Class="GuitarCam.App.MainWindow"
        Title="GuitarCam Studio"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="None"
        Background="{StaticResource App}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="PreferSystemChrome">

  <!-- TransparencyLevelHint None: with transparency allowed, some dark video pixels let the window behind show through -->
  <Window.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.section.off TextBlock.dim, Border.section.off Slider, Border.section.off UniformGrid, Border.section.off CheckBox">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="44,*,4,340">

    <!-- top bar (also the window's title bar) -->
    <Border x:Name="TitleBar" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="12,0,150,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Accent}">
            <TextBlock Classes="icon" Text="&#xE714;" FontSize="13" Foreground="#0b0b0d" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="GuitarCam Studio" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
          <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
            <TextBlock Text="NATIVO" FontSize="9.5" FontWeight="Bold" LetterSpacing="0.8" Foreground="{StaticResource Accent}" />
          </Border>
        </StackPanel>

        <Button Grid.Column="1" x:Name="SessionChip" Classes="chip" Margin="18,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" Text="&#xE8B7;" FontSize="13" Foreground="{StaticResource Dim}" />
            <TextBlock x:Name="SessionName" Text="Sin proyecto" FontWeight="SemiBold" />
            <TextBlock Classes="icon" Text="&#xE70D;" FontSize="9" Foreground="{StaticResource Faint}" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
          <Button x:Name="UndoButton" Classes="ghost" IsEnabled="False" ToolTip.Tip="Deshacer (Ctrl+Z)">
            <TextBlock Classes="icon" Text="&#xE7A7;" />
          </Button>
          <Button x:Name="RedoButton" Classes="ghost" IsEnabled="False" ToolTip.Tip="Rehacer (Ctrl+Y)">
            <TextBlock Classes="icon" Text="&#xE7A6;" />
          </Button>
        </StackPanel>

        <TextBlock Grid.Column="3" x:Name="StatusText" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" Margin="0,0,14,0" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="ENTRADA 1-2" VerticalAlignment="Center" />
          <c:StereoMeter x:Name="InputMeter" Width="160" VerticalAlignment="Center" ToolTip.Tip="Entrada de la interfaz (clic: apaga el indicador de clip)" />
          <Button Classes="ghost" ToolTip.Tip="Configuración">
            <TextBlock Classes="icon" Text="&#xE713;" />
          </Button>
        </StackPanel>

        <Button Grid.Column="5" x:Name="ExportButton" Classes="accent" ToolTip.Tip="Exportar MP4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Classes="icon" Text="&#xE72D;" FontSize="12" Foreground="#0b0b0d" />
            <TextBlock Text="Exportar MP4" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- inspector + preview -->
    <Grid Grid.Row="1" ColumnDefinitions="290,*">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel x:Name="Inspector" Margin="14,16" Spacing="12" />
        </ScrollViewer>
      </Border>

      <c:PreviewView Grid.Column="1" x:Name="Preview" />
    </Grid>

    <GridSplitter Grid.Row="2" Background="{StaticResource Line}" ResizeDirection="Rows" />

    <!-- transport + timeline -->
    <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1" Padding="16,10">
        <WrapPanel Orientation="Horizontal">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
            <Button x:Name="RecButton" Classes="chip" Height="40" Background="{StaticResource RecSoft}" BorderBrush="#80ef4444" ToolTip.Tip="Grabar en una pista nueva al final (R)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="12" Height="12" Fill="{StaticResource Rec}" />
                <TextBlock Text="Grabar" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="RecordTargetText" Classes="dim" Text="→ pista nueva" MaxWidth="140" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ToStartButton" Classes="chip" Width="40" Height="40" Padding="0" CornerRadius="6,0,0,6" ToolTip.Tip="Volver al inicio (Inicio)">
                <TextBlock Classes="icon" Text="&#xE892;" FontSize="14" />
              </Button>
              <Button x:Name="StopButton" Classes="chip" Width="40" Height="40" Padding="0" CornerRadius="0" BorderThickness="0,1" ToolTip.Tip="Detener (vuelve a donde arrancó; si ya está detenido, al inicio)">
                <TextBlock Classes="icon" Text="&#xE71A;" FontSize="14" />
              </Button>
              <Button x:Name="PlayButton" Classes="chip" Width="40" Height="40" Padding="0" CornerRadius="0,6,6,0" ToolTip.Tip="Reproducir desde el cabezal (Espacio)">
                <TextBlock x:Name="PlayIcon" Classes="icon" Text="&#xE768;" FontSize="14" />
              </Button>
            </StackPanel>
            <ToggleButton x:Name="LoopToggle" Classes="chip" Width="40" Height="40" Padding="0" IsChecked="True" ToolTip.Tip="Repetir en loop">
              <TextBlock Classes="icon" Text="&#xE8EE;" FontSize="14" />
            </ToggleButton>
          </StackPanel>
          <Button x:Name="ClockButton" Classes="chip" Background="{StaticResource App}" MinWidth="150" Height="40" Margin="0,0,16,0" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <TextBlock x:Name="TimeText" Classes="mono" FontSize="19" Text="1.1.1" />
              <TextBlock x:Name="BarText" Classes="mono" Foreground="{StaticResource Faint}" FontSize="14" Text="/ 1.1.1" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,4,16,4">
            <c:TempoControl x:Name="Tempo" />
            <ToggleButton x:Name="CountInToggle" Classes="chip" IsChecked="True" ToolTip.Tip="Cuenta de 4 tiempos antes de grabar (Shift+C)">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Cuenta" /><TextBlock Classes="mono" FontSize="9" Text="⇧C" /></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ClickToggle" Classes="chip" ToolTip.Tip="Metrónomo al grabar y al reproducir (C)">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Click" /><TextBlock Classes="mono" FontSize="9" Text="C" /></StackPanel>
            </ToggleButton>
            <Button x:Name="ClickSoundButton" Classes="chip" Width="24" Padding="0" Margin="-6,0,0,0" ToolTip.Tip="Sonido del click: Bip">
              <TextBlock Classes="icon" Text="&#xE70D;" FontSize="11" />
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,4,12,4" VerticalAlignment="Center">
            <Button Classes="chip" Content="Timeline" ToolTip.Tip="Alternar timeline / mixer (X)" />
            <Button Classes="chip" Content="Mixer" IsEnabled="False" ToolTip.Tip="Todavía no está en la versión nativa" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,4,0,4">
            <TextBlock x:Name="DspText" Classes="mono dim" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Carga del callback de audio" />
            <TextBlock x:Name="AudioStatus" Classes="dim" FontSize="11" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis" />
            <Button x:Name="FitButton" Classes="chip" ToolTip.Tip="Ver todo (F)"><TextBlock Text="Ver todo" /></Button>
          </StackPanel>
        </WrapPanel>
      </Border>

      <Grid Grid.Row="1">
        <c:TimelineView x:Name="Timeline" />
        <Grid x:Name="TimelineToolbar" Width="264" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="{StaticResource Panel}" ColumnDefinitions="26,26,84,26,*" Margin="0">
          <Button x:Name="BarsRulerButton" Classes="ghost" Padding="2" MinWidth="0" ToolTip.Tip="Regla en compases y tiempos (4/4, al tempo del click)">
            <TextBlock Classes="icon" Text="&#xE8D6;" FontSize="13" />
          </Button>
          <Button Grid.Column="1" x:Name="TimeRulerButton" Classes="ghost" Padding="2" MinWidth="0" ToolTip.Tip="Regla en minutos y segundos">
            <TextBlock Classes="icon" Text="&#xE823;" FontSize="13" />
          </Button>
          <ComboBox Grid.Column="2" x:Name="SnapBox" FontSize="11" MinHeight="24" Height="26" Padding="4,0" VerticalAlignment="Center"
                    ToolTip.Tip="Imán a la grilla: cabezal, mover clips, recortes y fades (Alt: sin imán)" AutomationProperties.Name="Imán a la grilla" />
          <Button Grid.Column="3" x:Name="TimelineFitButton" Classes="ghost" Padding="2" MinWidth="0" ToolTip.Tip="Ver todo (ajustar el zoom al ancho)">
            <TextBlock Classes="icon" Text="&#xE9A6;" FontSize="13" />
          </Button>
          <Slider Grid.Column="4" x:Name="TrackHeightSlider" Minimum="40" Maximum="160" Value="64" Margin="6,0,8,0" VerticalAlignment="Center"
                  ToolTip.Tip="Altura de las pistas" AutomationProperties.Name="Altura de las pistas" />
        </Grid>
      </Grid>
    </Grid>

    <!-- the "Proyectos" manager covers the whole window, like in the web app -->
    <c:ProjectsDialog Grid.RowSpan="4" x:Name="Projects" IsVisible="False" />
    <d:ExportDialog Grid.RowSpan="4" x:Name="Export" IsVisible="False" AutomationProperties.Name="Exportar video" />
  </Grid>
</Window>
