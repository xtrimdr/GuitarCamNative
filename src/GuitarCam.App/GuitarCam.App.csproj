<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GuitarCam</AssemblyName>
    <!-- what Windows shows for the exe (Task Manager, "Open with", file properties) -->
    <Product>GuitarCam Studio Native</Product>
    <AssemblyTitle>GuitarCam Studio Native</AssemblyTitle>
    <!-- Drawn by tools/make-icon.ps1 -->
    <ApplicationIcon>Assets\GuitarCam.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\GuitarCam.ico" />
    <AvaloniaResource Include="Assets\GuitarCam-64.png" />
    <AvaloniaResource Include="Assets\Lang\*.json" />
    <!-- the instrument icons' license travels with the exe -->
    <None Include="Assets\Icons\IconOven-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuitarCam.Audio\GuitarCam.Audio.csproj" />
    <ProjectReference Include="..\GuitarCam.Projects\GuitarCam.Projects.csproj" />
  </ItemGroup>

</Project>
